#!/bin/bash
# cloud-init for RKE2 agent nodes. Logs: /var/log/cloud-init-output.log
set -euxo pipefail

iptables -P INPUT ACCEPT && iptables -P FORWARD ACCEPT && iptables -F
netfilter-persistent save || true

# Wait for the server's supervisor port before joining.
until curl -sk https://${server_ip}:9345/ping >/dev/null; do sleep 10; done

mkdir -p /etc/rancher/rke2
cat > /etc/rancher/rke2/config.yaml <<CFG
server: https://${server_ip}:9345
token: ${token}
CFG

curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="${rke2_version}" INSTALL_RKE2_TYPE="agent" sh -
systemctl enable --now rke2-agent.service
