#!/bin/bash
# cloud-init for the RKE2 server node. Logs: /var/log/cloud-init-output.log
set -euxo pipefail

# OCI's Ubuntu images ship iptables REJECT rules that silently break
# Kubernetes networking. NSGs are our firewall, so open the host firewall.
iptables -P INPUT ACCEPT && iptables -P FORWARD ACCEPT && iptables -F
netfilter-persistent save || true

mkdir -p /etc/rancher/rke2
cat > /etc/rancher/rke2/config.yaml <<CFG
token: ${token}
tls-san:
  - ${server_ip}
  - 127.0.0.1
write-kubeconfig-mode: "0640"
node-taint: []
CFG

curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION="${rke2_version}" sh -
systemctl enable --now rke2-server.service

# Make kubectl usable on the server for debugging.
ln -sf /var/lib/rancher/rke2/bin/kubectl /usr/local/bin/kubectl
echo 'export KUBECONFIG=/etc/rancher/rke2/rke2.yaml' > /etc/profile.d/rke2.sh
